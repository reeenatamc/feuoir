# Copiar a `.env` y completar. NUNCA commitear el `.env` real.

# Puerto HTTP de la API
PORT=3001

# Origenes permitidos por CORS, separados por coma.
# En produccion poner el dominio real del frontend.
CORS_ORIGINS=http://localhost:5173

# Numero de WhatsApp del negocio en formato internacional, solo digitos
# (sin +, espacios ni guiones). Ej: 15551234567
WHATSAPP_PHONE=
