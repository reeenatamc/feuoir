# Copiar a `.env` y completar con los valores del proyecto.
# NUNCA poner credenciales reales en este archivo: se commitea al repo.
#
# IMPORTANTE: todo lo que empiece con VITE_ se inyecta LITERAL en el bundle
# publico del navegador. Solo pueden ir valores publicos aqui.
# La `service_role` key de Supabase NUNCA va en el frontend.

# ── Backend propio ─────────────────────────────────────────
# Base de la API, sin barra final. Si se omite, el cliente usa
# http://127.0.0.1:8000/api, que es donde escucha el backend en desarrollo:
# clonar el repo y levantar Vite funciona sin configurar nada.
VITE_API_URL=http://127.0.0.1:8000/api

# ── Supabase ───────────────────────────────────────────────
# Project Settings → API en el dashboard de Supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
